# Debian apt packages (git, make, gcc, libc6-dev) are NOT snapshot-pinned:
# recorded in /usr/local/share/apt-versions.txt only. Technical debt TD-01.
# Minimum git: tools/check_linkage.py needs --no-lazy-fetch (git >= 2.44).
# Debian trixie base provides git 2.47; bookworm (2.39) is not sufficient.
GIT_MIN_VERSION=2.44
