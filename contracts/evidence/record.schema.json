{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/evidence/record.schema.json",
  "title": "M0-E02-S04 evidence record (schema 1)",
  "description": "Documentation of the record shape. tools/check_evidence.py enforces it (standard library, no jsonschema dependency) plus the cross-field rules in refinements/M0-E02-S04.md (docs repo).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "story", "acceptance", "subject", "tier", "kinds", "environment_class", "cost_class",
               "origin", "run_by", "environment", "command", "revision", "started_at", "finished_at", "result", "exit_code"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"},
    "story": {"type": "string", "pattern": "^M[0-9]+-E[0-9]{2}-S[0-9]{2}$"},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]+-E[0-9]{2}-S[0-9]{2}-AC[0-9]{2}$"}},
    "subject": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["tests"], "properties": {"tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
      {"type": "object", "additionalProperties": false, "required": ["gate"], "properties": {"gate": {"type": "string"}}}
    ]},
    "tier": {"type": "string"},
    "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "environment_class": {"enum": ["simulated", "emulated", "nested", "bare_metal"]},
    "cost_class": {"enum": ["T0", "T1", "T2", "T3", "T4"]},
    "origin": {"const": "local"},
    "run_by": {"enum": ["agent", "human"]},
    "run_by_name": {"type": "string", "minLength": 2},
    "environment": {"type": "object", "additionalProperties": false,
      "required": ["kind", "image", "toolchain", "apt_versions_sha256", "os", "kernel", "arch"],
      "properties": {"kind": {"enum": ["local_container", "host"]}, "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "toolchain": {"type": "object", "additionalProperties": {"type": "string"}},
        "apt_versions_sha256": {"type": ["string", "null"]}, "os": {"type": "string"}, "kernel": {"type": "string"},
        "arch": {"type": "string"}, "libvirt": {"type": ["string", "null"]}}},
    "command": {"type": "array", "items": {"type": "string"}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["platform", "tree_clean", "docs"],
      "properties": {"platform": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree_clean": {"const": true},
        "docs": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "started_at": {"type": "string"}, "finished_at": {"type": "string"},
    "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
    "exit_code": {"type": ["integer", "null"]},
    "reason": {"type": "string", "minLength": 3},
    "blocker": {"type": "string"},
    "log": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^evidence/logs/EV-[0-9a-f]{16}\\.log$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
