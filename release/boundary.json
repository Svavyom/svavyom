{
  "schema": 1,
  "description": "Public / private boundary of the product repository (M0-S08). Every tracked path must match exactly one 'public' or 'internal' rule; no tracked path may match a 'private' rule. 'public' = may be placed in a release snapshot; 'internal' = tracked for the team but not part of any public snapshot; 'private' = must never be tracked, packaged or snapshotted. The launch workspace (/home/user/Svavyom-Web) is not part of this repository and is never modified from here.",
  "public": [
    "README.md",
    "Makefile",
    "compose.yaml",
    "VERSION",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "docs-lock.json",
    "AGENTS.md",
    "backend/**",
    "agent/**",
    "frontend/**",
    "contracts/**",
    "packages/**",
    "toolchain/**",
    "tools/**",
    "release/**",
    "ci/**",
    ".github/**",
    ".gitignore",
    ".dockerignore",
    ".gitleaks.toml",
    ".gitleaks-dir.toml",
    ".gitleaksignore",
    "docs/*.md",
    "docs/sbom/**",
    "OPERATOR_ACTIONS_REQUIRED.md",
    "NOTICE",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CLA.md",
    "BUILDING.md",
    "INSTALLING.md",
    "USING.md",
    "REUSE.toml",
    "LICENSES/**",
    "SOURCE-OFFER.md"
  ],
  "internal": [
    "tests/**",
    "evidence/**",
    "prompts/**",
    "research/**",
    "docs/review/**",
    "certification/**"
  ],
  "private": [
    "**/*.key",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
    "**/.env",
    "**/.env.*",
    "**/*.db",
    "**/*.db-*",
    "**/*.sqlite*",
    "**/known_hosts",
    "**/qualification-out/**",
    "**/support-bundle*",
    "**/*.pcap",
    "**/*.core",
    "**/node_modules/**",
    "**/dist/**",
    "**/test-results/**",
    ".claude/**",
    "**/*password*",
    "**/*secret*"
  ],
  "private_exceptions": [
    "backend/internal/auth/password.go",
    "backend/internal/auth/password_test.go",
    "tests/fixtures/ci-policy/bypass/*secret*"
  ],
  "content_markers": [
    "OPENSSH PRIVATE KEY",
    "RSA PRIVATE KEY",
    "EC PRIVATE KEY",
    "DSA PRIVATE KEY",
    "ENCRYPTED PRIVATE KEY",
    "PRIVATE KEY"
  ],
  "content_marker_exceptions": [
    "tests/**",
    "tools/check_boundary.py",
    "evidence/**",
    "backend/**/*_test.go",
    "frontend/src/**/*.test.*",
    "frontend/e2e/**",
    "docs/*.md",
    "release/boundary.json"
  ],
  "content_marker_note": "Each entry is the label of a PEM block; the checker searches for the full armor line (five dashes, BEGIN, the label, five dashes). The armor is built at run time so this file does not itself look like a key to secret scanners."
}
