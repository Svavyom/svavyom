{
  "schema": 1,
  "description": "Canonical test-evidence taxonomy (M0-E02-S04; DR-006 D2 = A). Authoritative for cloud-platform tools/check_evidence.py, read at the pinned docs commit. In M0 no hosted evidence and no tier above T1 is accepted; accepting them requires a later approved story or decision defining provenance verification (DR-004: deferred, not waived).",
  "tiers": {
    "unit": {"cost_class": "T0", "environment_class": "simulated", "accepted_in_m0": true,
             "description": "In-process; no I/O beyond temp files; includes the S03 in-memory fake and contract/schema checkers"},
    "container_integration": {"cost_class": "T1", "environment_class": "simulated", "accepted_in_m0": true,
             "description": "Multi-process tests in the pinned container or on the host (gate-defect, container-safety, API + ephemeral DB, docker compose); no hypervisor beyond the S03 test driver"},
    "simulated_libvirt": {"cost_class": "T1", "environment_class": "simulated", "accepted_in_m0": true,
             "description": "libvirt test:///default through the cgo adapter (-tags libvirt_test)"},
    "browser_e2e": {"cost_class": "T1", "environment_class": "simulated", "accepted_in_m0": true,
             "description": "UI journeys against a local stack"},
    "emulated_vm": {"cost_class": "T2", "environment_class": "emulated", "accepted_in_m0": false,
             "description": "Actual guest boot under QEMU software emulation"},
    "nested_kvm": {"cost_class": "T2", "environment_class": "nested", "accepted_in_m0": false,
             "description": "Actual guest boot under nested KVM"},
    "bare_metal": {"cost_class": "T3", "environment_class": "bare_metal", "accepted_in_m0": false,
             "description": "Authorized disposable dedicated host"},
    "hardware_matrix": {"cost_class": "T4", "environment_class": "bare_metal", "accepted_in_m0": false,
             "description": "Additional CPU/kernel/distribution variants on hardware"}
  },
  "real_kvm_tiers": ["nested_kvm", "bare_metal", "hardware_matrix"],
